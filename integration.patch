diff --git a/.github/workflows/npm_publish_tari_l1_wasm.yml b/.github/workflows/npm_publish_tari_l1_wasm.yml
new file mode 100644
index 000000000..3fd641b7b
--- /dev/null
+++ b/.github/workflows/npm_publish_tari_l1_wasm.yml
@@ -0,0 +1,59 @@
+name: Publish tari-l1-wasm to npm
+
+on:
+  # Publish manually from the Actions tab, providing your npm scope.
+  workflow_dispatch:
+    inputs:
+      scope:
+        description: "npm scope (e.g. @your-scope)"
+        required: true
+        default: "@your-scope"
+      dry_run:
+        description: "Prepare package but skip npm publish"
+        required: false
+        default: "false"
+
+jobs:
+  publish:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+
+      - name: Install Rust toolchain
+        uses: dtolnay/rust-toolchain@stable
+        with:
+          targets: wasm32-unknown-unknown
+
+      - name: Cache cargo
+        uses: actions/cache@v4
+        with:
+          path: |
+            ~/.cargo/registry
+            ~/.cargo/git
+            target
+          key: wasm-pack-${{ hashFiles('Cargo.lock') }}
+
+      - name: Install wasm-pack
+        run: cargo install wasm-pack --locked
+
+      - name: Run native validation tests
+        run: cargo test -p tari_l1_wasm --test native_roundtrip
+
+      - name: Build WASM package
+        env:
+          CARGO_PROFILE_RELEASE_LTO: fat
+          CARGO_PROFILE_RELEASE_CODEGEN_UNITS: 1
+        run: >
+          wasm-pack build base_layer/tari_l1_wasm
+          --target bundler --release --out-dir pkg
+
+      - name: Prepare package metadata
+        working-directory: base_layer/tari_l1_wasm
+        run: node scripts/prepare-package.mjs --scope "${{ inputs.scope }}"
+
+      - name: Publish to npm
+        if: ${{ inputs.dry_run != 'true' }}
+        working-directory: base_layer/tari_l1_wasm/pkg
+        env:
+          NODE_AUTH_TOKEN: ${{ secrets.NPM_TOKEN }}
+        run: npm publish --access public
