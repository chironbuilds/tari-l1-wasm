+    /// Pre-seed the cached transaction input. Light clients that rebuild inputs from
+    /// chain-provided data (e.g. compact inputs carrying the chain-stored output hash)
+    /// can seed the exact input here so `to_transaction_input` returns it verbatim.
+    pub fn seed_transaction_input(&self, input: TransactionInput) {
+        let _unused = self.input.set(input);
+    }
